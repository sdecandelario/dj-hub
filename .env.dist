# Copy to .env (git-ignored) and fill in the real values. The app and the djhub command read .env at start.
# A variable already set in the shell wins over this file.

# Spotify app keys: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Last.fm API key: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Soulseek account for downloads. Logging in with a new username creates the account.
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=
